generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ORGANIZER
  PARTNER
  GUEST
}

enum EventStatus {
  DRAFT
  UPCOMING
  LIVE
  COMPLETED
  ARCHIVED
  EXPIRED
}

enum EventPrivacy {
  PUBLIC_LINK
  PRIVATE
  UPLOAD_ONLY
  MODERATED
}

enum EventType {
  WEDDING
  BIRTHDAY
  GRADUATION
  REUNION
  CORPORATE
  PARTY
  SCHOOL
  FAMILY
  OTHER
}

enum MediaType {
  PHOTO
  VIDEO
  LIVE_MOMENT
}

enum UploadStatus {
  PENDING
  UPLOADING
  COMPLETE
  FAILED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
  SKIPPED
}

enum AiStatus {
  NONE
  QUEUED
  PROCESSING
  COMPLETE
  FAILED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum PhotoFilter {
  ORIGINAL
  DISPOSABLE_CAM
  VINTAGE_FILM
  RETRO
  CLASSIC
}

enum PhotoFrame {
  NO_FRAME
  POLAROID_WHITE
  POLAROID_VINTAGE
  FILM_FRAME
  MINIMAL_FRAME
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
  EXPIRED
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PartnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventAccessRole {
  OWNER
  MANAGER
  VIEWER
}

enum PromotionType {
  FIRST_EVENT
  REFERRAL_VOUCHER
}

enum ReferralStatus {
  PENDING
  REWARDED
}

enum ReferralVoucherStatus {
  AVAILABLE
  RESERVED
  USED
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  referralCode String?  @unique
  role         UserRole @default(ORGANIZER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedEvents                   Event[]                 @relation("EventOwner")
  orders                        Order[]
  partnerAccount                PartnerAccount?
  partnerApplications           PartnerApplication[]    @relation("PartnerApplicant")
  reviewedPartnerApplications   PartnerApplication[]    @relation("PartnerApplicationReviewer")
  partnerDiscountTiers          PartnerDiscountTier[]   @relation("PartnerDiscountTierUpdater")
  createdPartnerPriceAgreements PartnerPriceAgreement[] @relation("PartnerPriceAgreementCreator")
  partnerClients                PartnerClient[]
  accessGrants                  EventAccessGrant[]
  memories                      Memory[]                @relation("MemoryUploader")
  mediaAssets                   MediaAsset[]            @relation("MediaUploader")
  moderationFlags               ModerationFlag[]        @relation("FlagReporter")
  promotionSettingsUpdated      PromotionSettings[]
  referralsSent                 Referral[]              @relation("ReferralReferrer")
  referralReceived              Referral?               @relation("ReferralReferred")
  referralVouchers              ReferralVoucher[]
  freeTrial                     FreeTrial?
}

model GuestSession {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  eventId     String
  displayName String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memories Memory[]

  @@index([eventId])
}

model Package {
  id                     String   @id @default(cuid())
  name                   String
  guestCapacity          Int?
  isUnlimited            Boolean  @default(false)
  price                  Decimal  @db.Decimal(12, 2)
  currency               String   @default("IDR")
  storageLimitBytes      BigInt
  photoLimit             Int?
  videoLimit             Int?
  videoDurationLimit     Int?
  eventDurationDays      Int
  retentionDays          Int
  customEventPage        Boolean  @default(false)
  customQRCode           Boolean  @default(false)
  filtersEnabled         Boolean  @default(false)
  framesEnabled          Boolean  @default(false)
  aiEnhancementEnabled   Boolean  @default(false)
  aiCurationEnabled      Boolean  @default(false)
  digitalAlbumEnabled    Boolean  @default(false)
  liveMomentEnabled      Boolean  @default(false)
  eventChallengesEnabled Boolean  @default(false)
  isActive               Boolean  @default(false)
  metadata               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  events              Event[]
  orders              Order[]
  partnerCustomPrices PartnerCustomPrice[]
}

model Event {
  id            String       @id @default(cuid())
  ownerId       String
  packageId     String?
  name          String
  organizerName String?
  slug          String       @unique
  description   String?
  eventType     EventType    @default(WEDDING)
  eventDate     DateTime?
  startsAt      DateTime?
  endsAt        DateTime?
  timeZone      String?
  location      String?
  coverImageKey String?
  status        EventStatus  @default(DRAFT)
  privacyMode   EventPrivacy @default(PUBLIC_LINK)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  expiresAt     DateTime?

  owner           User                @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  package         Package?            @relation(fields: [packageId], references: [id], onDelete: SetNull)
  customization   EventCustomization?
  photoExperience PhotoExperience?
  qrCode          QRCode?
  storageUsage    StorageUsage?
  guestSessions   GuestSession[]
  memories        Memory[]
  mediaAssets     MediaAsset[]
  challenges      Challenge[]
  albums          Album[]
  orders          Order[]
  accessGrants    EventAccessGrant[]
  freeTrial       FreeTrial?

  @@index([ownerId])
  @@index([status])
}

model EventCustomization {
  id             String   @id @default(cuid())
  eventId        String   @unique
  welcomeTitle   String?
  welcomeMessage String?
  accentColor    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model PhotoExperience {
  id        String      @id @default(cuid())
  eventId   String      @unique
  filter    PhotoFilter @default(ORIGINAL)
  frame     PhotoFrame  @default(NO_FRAME)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model QRCode {
  id             String   @id @default(cuid())
  eventId        String   @unique
  destinationUrl String
  scanCount      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model StorageUsage {
  id         String   @id @default(cuid())
  eventId    String   @unique
  quotaBytes BigInt
  usedBytes  BigInt   @default(0)
  photoBytes BigInt   @default(0)
  videoBytes BigInt   @default(0)
  otherBytes BigInt   @default(0)
  updatedAt  DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Memory {
  id             String   @id @default(cuid())
  eventId        String
  uploaderId     String?
  guestSessionId String?
  caption        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event         Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploader      User?                 @relation("MemoryUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  guestSession  GuestSession?         @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  mediaAssets   MediaAsset[]
  albumItems    AlbumItem[]
  challengeSubs ChallengeSubmission[]
  flags         ModerationFlag[]

  @@index([eventId])
}

model MediaAsset {
  id                  String           @id @default(cuid())
  eventId             String
  memoryId            String?
  uploaderId          String?
  idempotencyKey      String?
  type                MediaType
  originalStorageKey  String
  optimizedStorageKey String?
  thumbnailStorageKey String?
  mimeType            String
  fileSize            BigInt
  width               Int?
  height              Int?
  duration            Float?
  uploadStatus        UploadStatus     @default(PENDING)
  processingStatus    ProcessingStatus @default(PENDING)
  aiStatus            AiStatus         @default(NONE)
  moderationStatus    ModerationStatus @default(APPROVED)
  caption             String?
  createdAt           DateTime         @default(now())
  expiresAt           DateTime?

  event    Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memory   Memory?          @relation(fields: [memoryId], references: [id], onDelete: SetNull)
  uploader User?            @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  aiJobs   AIMediaJob[]
  flags    ModerationFlag[]

  @@unique([eventId, idempotencyKey])
  @@index([eventId])
  @@index([memoryId])
}

model Challenge {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submissions ChallengeSubmission[]

  @@index([eventId])
}

model ChallengeSubmission {
  id          String   @id @default(cuid())
  challengeId String
  memoryId    String
  createdAt   DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  memory    Memory    @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}

model Album {
  id          String   @id @default(cuid())
  eventId     String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items AlbumItem[]

  @@index([eventId])
}

model AlbumItem {
  id        String @id @default(cuid())
  albumId   String
  memoryId  String
  sortOrder Int    @default(0)

  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([albumId])
}

model AIMediaJob {
  id           String   @id @default(cuid())
  mediaAssetId String
  jobType      String
  provider     String?
  status       AiStatus @default(QUEUED)
  payload      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([mediaAssetId])
}

model ModerationFlag {
  id           String           @id @default(cuid())
  mediaAssetId String?
  memoryId     String?
  reason       String
  status       ModerationStatus @default(PENDING)
  reporterId   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  memory     Memory?     @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  reporter   User?       @relation("FlagReporter", fields: [reporterId], references: [id], onDelete: SetNull)
}

model Order {
  id               String         @id @default(cuid())
  orderNumber      String         @unique
  idempotencyKey   String         @unique
  userId           String
  packageId        String
  eventId          String?        @unique
  packageSnapshot  Json
  status           OrderStatus    @default(PENDING)
  amount           Decimal        @db.Decimal(12, 2)
  currency         String
  expiresAt        DateTime?
  clientName       String?
  priceSnapshot    Json?
  baseAmount       Decimal?       @db.Decimal(12, 2)
  discountAmount   Decimal        @default(0) @db.Decimal(12, 2)
  promotionType    PromotionType?
  partnerAccountId String?
  tierCountedAt    DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  package         Package          @relation(fields: [packageId], references: [id], onDelete: Restrict)
  event           Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  partnerAccount  PartnerAccount?  @relation(fields: [partnerAccountId], references: [id], onDelete: SetNull)
  payments        Payment[]
  referralVoucher ReferralVoucher? @relation("ReferralVoucherOrder")
  referralReward  Referral?        @relation("ReferralRewardOrder")

  @@index([userId, createdAt])
  @@index([partnerAccountId, status])
  @@index([promotionType, status])
}

model Payment {
  id                  String        @id @default(cuid())
  orderId             String
  provider            String
  providerRef         String?       @unique
  checkoutUrl         String?
  checkoutRequestedAt DateTime?
  status              PaymentStatus @default(PENDING)
  amount              Decimal       @db.Decimal(12, 2)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, provider])
}

model PartnerAccount {
  id             String        @id @default(cuid())
  userId         String        @unique
  businessName   String
  status         PartnerStatus @default(PENDING)
  paidOrderCount Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders          Order[]
  clients         PartnerClient[]
  applications    PartnerApplication[]
  priceAgreements PartnerPriceAgreement[]
}

model PartnerApplication {
  id                  String                   @id @default(cuid())
  userId              String
  partnerAccountId    String?
  businessName        String
  businessType        String
  businessDescription String
  businessAddress     String
  city                String
  province            String
  website             String?
  contactName         String
  contactPhone        String
  position            String
  eventsPerMonth      Int
  typicalEventTypes   String
  reason              String
  status              PartnerApplicationStatus @default(PENDING)
  adminNote           String?
  canReapply          Boolean                  @default(false)
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  applicant      User            @relation("PartnerApplicant", fields: [userId], references: [id], onDelete: Cascade)
  partnerAccount PartnerAccount? @relation(fields: [partnerAccountId], references: [id], onDelete: SetNull)
  reviewer       User?           @relation("PartnerApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PartnerClient {
  id               String   @id @default(cuid())
  partnerAccountId String
  organizerUserId  String
  createdAt        DateTime @default(now())

  partnerAccount PartnerAccount @relation(fields: [partnerAccountId], references: [id], onDelete: Cascade)
  organizer      User           @relation(fields: [organizerUserId], references: [id], onDelete: Cascade)

  @@index([partnerAccountId])
}

model PartnerDiscountTier {
  id              String   @id @default(cuid())
  minPaidOrders   Int
  discountPercent Int
  active          Boolean  @default(true)
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  updatedBy User? @relation("PartnerDiscountTierUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([minPaidOrders])
  @@index([active, minPaidOrders])
}

model PartnerPriceAgreement {
  id               String    @id @default(cuid())
  partnerAccountId String
  startsAt         DateTime
  endsAt           DateTime?
  active           Boolean   @default(true)
  notes            String?
  createdById      String?
  createdAt        DateTime  @default(now())

  partnerAccount PartnerAccount       @relation(fields: [partnerAccountId], references: [id], onDelete: Cascade)
  createdBy      User?                @relation("PartnerPriceAgreementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  prices         PartnerCustomPrice[]

  @@index([partnerAccountId, active, startsAt, endsAt])
}

model PartnerCustomPrice {
  id          String  @id @default(cuid())
  agreementId String
  packageId   String
  price       Decimal @db.Decimal(12, 2)

  agreement PartnerPriceAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  package   Package               @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@unique([agreementId, packageId])
}

model EventAccessGrant {
  id        String          @id @default(cuid())
  eventId   String
  userId    String
  role      EventAccessRole @default(MANAGER)
  createdAt DateTime        @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model PromotionSettings {
  id               String   @id @default("global")
  firstEventActive Boolean  @default(true)
  referralActive   Boolean  @default(true)
  updatedAt        DateTime @updatedAt
  updatedById      String?

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model Referral {
  id             String         @id @default(cuid())
  referralCode   String
  referrerId     String
  referredUserId String         @unique
  status         ReferralStatus @default(PENDING)
  rewardOrderId  String?        @unique
  createdAt      DateTime       @default(now())
  rewardedAt     DateTime?

  referrer    User             @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Restrict)
  referred    User             @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Restrict)
  rewardOrder Order?           @relation("ReferralRewardOrder", fields: [rewardOrderId], references: [id], onDelete: SetNull)
  voucher     ReferralVoucher?

  @@index([referrerId, createdAt])
  @@index([status, createdAt])
}

model ReferralVoucher {
  id         String                @id @default(cuid())
  ownerId    String
  referralId String                @unique
  orderId    String?               @unique
  amount     Decimal               @db.Decimal(12, 2)
  status     ReferralVoucherStatus @default(AVAILABLE)
  expiresAt  DateTime
  createdAt  DateTime              @default(now())
  usedAt     DateTime?

  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  referral Referral @relation(fields: [referralId], references: [id], onDelete: Restrict)
  order    Order?   @relation("ReferralVoucherOrder", fields: [orderId], references: [id], onDelete: SetNull)

  @@index([ownerId, status, expiresAt])
  @@index([createdAt])
}

model FreeTrial {
  id         String    @id @default(cuid())
  userId     String    @unique
  eventId    String    @unique
  photoLimit Int       @default(10)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}
